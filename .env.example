# ─────────────────────────────────────────────────────────────────────────
# Core auth (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────

# Signs customer and admin session JWTs. The app refuses to sign/verify tokens
# without this — there is no insecure fallback.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-change-this-in-production

# First-login password for the /admin panel. On the very first admin login (when
# no password hash exists in KV yet) this value is hashed and stored. After you
# log in, change the password via the admin panel and you can remove this var.
# Min 8 characters. If unset, admin login is disabled (fail-closed by design).
ADMIN_BOOTSTRAP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# Vercel storage — auto-populated by Vercel when you connect the store.
# Leave blank locally; Vercel fills these in on deploy.
# ─────────────────────────────────────────────────────────────────────────

# Vercel KV (Redis) — source of truth for products, banners, journal, users.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Blob — stores uploaded product & banner images.
# REQUIRED for image uploads. Connect a Blob store under Storage → Blob in the
# Vercel dashboard; this token is set automatically. Without it, every image
# upload fails with a "BLOB_NOT_CONFIGURED" error.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Payments — Stripe (REQUIRED for checkout)
# ─────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (Stripe dashboard → Webhooks).
STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# AI — Anthropic (product descriptions & measurement estimates)
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# AI cost logging — Neon Postgres (shared beacons_usage_log table). Optional;
# logging is best-effort and never blocks a request.
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# eBay listing sync (optional)
# ─────────────────────────────────────────────────────────────────────────
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_ENV=production
EBAY_SELLER_USERNAME=
# Shared secret that protects the scheduled /api/cron/ebay-sync endpoint.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Instagram / Meta integration (optional)
# ─────────────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Transactional email — Resend (optional; for verification / order emails)
# ─────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=noreply@theluxine.com
MERCHANT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────
# Google Sheets export (optional)
# ─────────────────────────────────────────────────────────────────────────
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
